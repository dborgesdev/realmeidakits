# Merge this block with the existing document-root rules after backing them up.
# Keep the WordPress-managed /app/.htaccess in place.
RewriteEngine On
RewriteRule ^app/wp-content/rak-private-documents(?:/|$) - [F,NC]
RewriteRule ^app(?:/|$) - [L]
RewriteRule ^\.vite(?:/|$) - [F]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^$ index.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^(?:sitemap\.xml|corridas(?:/[a-z0-9-]{1,200})?/?)$ app/index.php [L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^solicitacao/([a-z0-9-]{1,200})/(?:pedido|responsavel|participantes|documentos|condicoes|revisao|pagamento|configuracao|identificacao|dados|confirmacao)/?$ /corridas/$1 [R=302,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteRule ^(?:orientacoes|privacidade|conta|conclusao|acompanhamento|solicitacao/(?:pedido|responsavel|participantes|documentos|condicoes|revisao|pagamento|configuracao|identificacao|dados|confirmacao))/?$ index.html [L]

<IfModule mod_headers.c>
    Header always set X-Robots-Tag "noindex, nofollow" "expr=%{THE_REQUEST} =~ m#^[A-Z]+ /(conta|solicitacao|acompanhamento|conclusao)[/\x3f\x20]#"
    <Files "index.html">
        Header set Cache-Control "no-cache"
    </Files>
    <FilesMatch "^.+-[A-Za-z0-9_-]{8}\.(?:js|css|woff2|webp|png|jpe?g|svg)$">
        Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{REQUEST_URI} =~ m#^/assets/#"
    </FilesMatch>
</IfModule>
